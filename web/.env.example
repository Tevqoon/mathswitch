WIKIPEDIA_CONTACT_EMAIL=my@email.com

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts, e.g. example.com,www.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Path to the SQLite database file.
# In Docker this is inside the 'db' named volume; leave as-is.
DB_PATH=/data/db.sqlite3

# Directory where collectstatic writes files.
# In Docker this is the 'static' named volume shared with nginx; leave as-is.
STATIC_ROOT=/static
